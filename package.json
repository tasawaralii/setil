{
  "name": "setil",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm dev:extension",
    "dev:extension": "pnpm --filter @setil/extension dev",
    "build": "pnpm --filter @setil/extension build",
    "dev:backend": "uv run uvicorn app.main:app --reload --app-dir apps/backend",
    "lint": "pnpm --filter @setil/extension lint"
  }
}
