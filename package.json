{
  "name": "setil",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "pnpm dev:extension",
    "dev:extension": "pnpm --filter @setil/extension dev",
    "build": "pnpm --filter @setil/extension build",
    "dev:backend": "python -m uvicorn api.index:app --reload --app-dir apps/backend",
    "lint": "pnpm --filter @setil/extension lint"
  }
}